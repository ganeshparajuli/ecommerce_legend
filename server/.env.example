# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database (PostgreSQL) ---
DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=joystore
DB_USER=joystore_app
DB_PASSWORD=
# Set to "true" to require SSL (typical for managed/hosted Postgres in production)
DB_SSL=false
DB_POOL_MAX=10
DB_POOL_MIN=0

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET_KEY=
JWT_EXPIRE=86400
COOKIE_EXPIRE=1

# --- App ---
NODE_ENV=development
PORT=7999
FRONTEND=http://localhost:5173

# --- Email (optional, only needed if transactional email is enabled) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Joy Store

# --- Payments (optional, only needed if Stripe checkout is enabled) ---
STRIPE_SECRET_KEY=
